# ============================================================
#  CHIRO.VN — Environment template
#  Copy to .env and fill in real values:  cp .env.example .env
#  NEVER commit the real .env file.
# ============================================================

# ── Server ──
PORT=3000
NODE_ENV=production

# ── Admin (shared secret protecting /api/admin/* endpoints) ──
ADMIN_SECRET_KEY=change_me_to_a_long_random_string

# ── Supabase (anon/publishable key — safe for the browser) ──
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# ── Google Apps Script (2nd-layer backup web app) ──
GOOGLE_SHEET_URL=https://script.google.com/macros/s/xxxxxxxx/exec

# ── Resend (transactional email — server-side only) ──
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
SENDER_EMAIL=admin@your-domain.com
REPLY_TO_EMAIL=you@example.com

# ── SQLite "second brain" (path on the server) ──
BRAIN_DB_PATH=./brain.db
